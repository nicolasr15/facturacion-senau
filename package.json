{
  "name": "facturacion-senau",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Worker que emite ante la DIAN una factura electrónica de venta (tipo 01) por cada pedido pagado en senau-tickets.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/run.ts",
    "db:migrate:local": "wrangler d1 migrations apply facturacion-senau --local",
    "db:migrate": "wrangler d1 migrations apply facturacion-senau --remote",
    "extract-cert": "node ./scripts/extract-cert.mjs",
    "secrets": "node ./scripts/set-secrets.mjs"
  },
  "dependencies": {
    "@dian-kit/core": "^1.0.1",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node-forge": "^1.3.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
